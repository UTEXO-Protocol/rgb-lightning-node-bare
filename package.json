  "scripts": {
    "prepublishOnly": "node scripts/verify-distribution-artifacts.js",
    "postinstall": "node scripts/install-distribution.js",
    "prepare-native": "node scripts/install-native-artifacts.js",
    "build": "bash scripts/build-prebuilds.sh",
    "build-cffi": "bash scripts/build-cffi.sh",
    "build-prebuilds": "bash scripts/build-prebuilds.sh",
    "check:types": "tsc --noEmit --strict --skipLibCheck index.d.ts && tsc --noEmit --strict --target es2020 --module node16 scripts/burn-types.ts",
    "test:installer": "node --test scripts/*.test.js",
    "test:environment": "node scripts/test-env-teardown.js",
    "test": "npm run test:installer && node ./node_modules/bare-runtime/bin/bare ./test.js && npm run test:environment",
    "hydrate-native": "node scripts/install-distribution.js",
    "stage:ios-payload": "node scripts/stage-ios-payload.js",
    "check:distribution": "node scripts/verify-distribution-artifacts.js",
    "stage:payloads": "node scripts/stage-native-payloads.js"
  },
  "dependencies": {
    "bare-fs": "^4.7.1",
    "bare-headers": "1.30.0",
    "bare-os": "^3.9.0",
    "bare-path": "^3.0.0",
