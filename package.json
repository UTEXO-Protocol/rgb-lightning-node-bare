  "types": "index.d.ts",
  "addon": true,
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "author": "UTEXO",
  "repository": {
    "type": "git",
    "url": "https://github.com/UTEXO-Protocol/rgb-lightning-node-bare.git"
  },
  "utexoNativeOverlay": {
