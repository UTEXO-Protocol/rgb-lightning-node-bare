    "cargoNdkVersion": "4.1.2",
    "bindgenCliVersion": "0.72.1",
    "bareHeadersVersion": "1.30.0",
    "targets": [
      "darwin-arm64",
      "ios-arm64",
      "ios-arm64-simulator",
      "ios-x64-simulator",
      "android-arm64",
      "android-arm",
      "android-x64"
    ],
    "rlnVersion": "0.17.0-beta.3"
  },
  "files": [
    "prebuilds/darwin-arm64/",
    ".utexo-native-overlay.json",
    "binding.js",
    "binding.cc",
    "index.d.ts",
    "rln.h",
    "CMakeLists.txt",
    "index.js",
    "json-boundary.js",
    "runtime-contract.json",
    "UPGRADE-TRACKER.md",
    "RELEASE-0.15-TRACKER.md",
