{
  "name": "@utexo/rgb-lightning-node-bare",
  "version": "0.1.0-beta.19",
  "description": "Bare native addon wrapping rgb-lightning-node C FFI for use in bare worklets",
  "main": "index.js",
  "types": "index.d.ts",
  "addon": true,
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "author": "UTEXO",
  "repository": {
    "type": "git",
    "url": "https://github.com/UTEXO-Protocol/rgb-lightning-node-bare.git"
  },
  "utexoNativeOverlay": {
    "repository": "https://github.com/UTEXO-Protocol/rgb-lightning-node.git",
    "ref": "v0.10.0-beta.3",
    "commit": "0bfa66fa256a6c36f3737d5b6402eacea40c68fc",
    "patch": "patches/c-ffi-utexo-patches-v0.10.0-beta.3.patch",
    "patchSha256": "a1cd3fddfbc6b2eb572e537ca538a80c034d85a3e4d90cdf00e6ceceb56792d4",
    "rustToolchain": "1.88.0",
    "iosDeploymentTarget": "16.0",
    "androidNdkVersion": "27.1.12297006",
    "androidApiLevel": 29,
    "cargoNdkVersion": "4.1.2",
    "bindgenCliVersion": "0.72.1",
    "targets": [
      "ios-arm64",
      "ios-arm64-simulator",
      "ios-x64-simulator",
      "android-arm64",
      "android-arm",
      "android-x64"
    ]
  },
  "files": [
    "binding.js",
    "binding.cc",
    "index.d.ts",
    "rln.h",
    "CMakeLists.txt",
    "index.js",
    "patches/",
    "prebuilds/",
    "lib/",
    "scripts/"
  ],
  "scripts": {
    "postinstall": "node scripts/install-native-artifacts.js",
    "prepare-native": "node scripts/install-native-artifacts.js",
    "build": "bash scripts/build-prebuilds.sh",
    "build-cffi": "bash scripts/build-cffi.sh",
    "build-prebuilds": "bash scripts/build-prebuilds.sh",
    "check:types": "tsc --noEmit --strict --skipLibCheck index.d.ts",
    "test:installer": "node --test scripts/*.test.js",
    "test": "npm run test:installer && node ./node_modules/bare-runtime/bin/bare ./test.js"
  },
  "dependencies": {
    "bare-fs": "^4.7.1",
    "bare-os": "^3.9.0",
    "bare-path": "^3.0.0",
    "cmake-bare": "^1.7.6",
    "cmake-npm": "^1.1.0",
    "require-addon": "^1.2.0"
  },
  "devDependencies": {
    "bare-runtime": "1.30.3",
    "typescript": "^6.0.3"
  }
}
