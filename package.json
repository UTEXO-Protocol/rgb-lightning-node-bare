  "types": "index.d.ts",
  "addon": true,
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "author": "UTEXO",
  "repository": {
    "type": "git",
    "url": "https://github.com/UTEXO-Protocol/rgb-lightning-node-bare.git"
  },
  "utexoNativeOverlay": {
    "repository": "https://github.com/UTEXO-Protocol/rgb-lightning-node.git",
    "ref": "v0.13.0-beta.3",
    "commit": "af03c7f1a65135a429f05a5820600338215954dc",
    "lightningCommit": "38d73bc918f27956590585d2bb83c86f059679b0",
    "patch": "patches/c-ffi-release-adapter-v0.13.0-beta.3.patch",
    "patchSha256": "aedd173294d3583b20cce36889c153f8b18aada794e4a7c32f1135266a28df00",
    "cffiLockSha256": "790ebf1a68fcc60f67f2e703dfc1abc2e3e65a52494b4156ec4de7c4b2d42b4b",
    "rustToolchain": "1.94.0",
    "iosDeploymentTarget": "16.0",
    "androidNdkVersion": "27.1.12297006",
    "androidApiLevel": 29,
    "cargoNdkVersion": "4.1.2",
    "bindgenCliVersion": "0.72.1",
    "bareHeadersVersion": "1.30.0",
    "targets": [
      "darwin-arm64",
      "ios-arm64",
      "ios-arm64-simulator",
      "ios-x64-simulator",
      "android-arm64",
      "android-arm",
      "android-x64"
    ]
  },
  "files": [
    "binding.js",
    "binding.cc",
    "index.d.ts",
    "rln.h",
    "CMakeLists.txt",
    "index.js",
    "json-boundary.js",
    "runtime-contract.json",
    "UPGRADE-TRACKER.md",
    "patches/",
    "scripts/"
  ],
  "scripts": {
    "postinstall": "node scripts/install-native-artifacts.js",
    "prepare-native": "node scripts/install-native-artifacts.js",
    "build": "bash scripts/build-prebuilds.sh",
    "build-cffi": "bash scripts/build-cffi.sh",
    "build-prebuilds": "bash scripts/build-prebuilds.sh",
    "check:types": "tsc --noEmit --strict --skipLibCheck index.d.ts",
    "test:installer": "node --test scripts/*.test.js",
    "test": "npm run test:installer && node ./node_modules/bare-runtime/bin/bare ./test.js"
  },
  "dependencies": {
    "bare-headers": "1.30.0",
    "bare-fs": "^4.7.1",
    "bare-os": "^3.9.0",
    "bare-path": "^3.0.0",
    "cmake-bare": "^1.7.6",
    "cmake-npm": "^1.1.0",
    "require-addon": "^1.2.0"
  },
  "devDependencies": {
    "bare-runtime": "1.30.3",
    "typescript": "^6.0.3"
  }
}
